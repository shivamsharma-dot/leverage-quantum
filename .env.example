# ─────────────────────────────────────────────────────
# LEVERAGE QUANTUM — Environment Variables
# ─────────────────────────────────────────────────────
# 1. Copy this file and rename it to:  .env
# 2. Fill in your values below
# 3. NEVER share your .env file with anyone
# ─────────────────────────────────────────────────────

# Get this from Google Cloud Console (Step 2 in SETUP_GUIDE.md)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Your ROAS Google Sheet ID (the long string in the URL)
# Example URL: https://docs.google.com/spreadsheets/d/1aL-T6sYxsonmhiFHUdoMHfr-t9dDYWtQZ-84vcZPqFg/edit
# Sheet ID  =  1aL-T6sYxsonmhiFHUdoMHfr-t9dDYWtQZ-84vcZPqFg
VITE_ROAS_SHEET_ID=1aL-T6sYxsonmhiFHUdoMHfr-t9dDYWtQZ-84vcZPqFg

# Get this from Google Cloud Console when you enable Sheets API (Step 3 in SETUP_GUIDE.md)
VITE_SHEETS_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY_HERE

# Anthropic Claude API key — powers VASU AI (the in-app AI chat).
# Get it from https://console.anthropic.com -> API Keys. Server-side only:
# do NOT use a VITE_ prefix (that would expose the secret to the browser).
# Add the same value as an Environment Variable named ANTHROPIC_API_KEY in Vercel.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
